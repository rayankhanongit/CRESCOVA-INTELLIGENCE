# Copy to backend/.env. Never commit .env. All values below are placeholders.

ENVIRONMENT=development            # set to "production" to require SECRET_KEY and hide /api/docs
SECRET_KEY=                        # empty in development = auto-generated into backend/.secret_key. REQUIRED in production (use: python -c "import secrets;print(secrets.token_urlsafe(48))")
DATABASE_URL=sqlite:///./crescova.db   # PostgreSQL example: postgresql+psycopg://user:password@localhost:5432/crescova (install psycopg first)
COOKIE_SECURE=false                # set true when served over HTTPS
ALLOW_REGISTRATION=true            # set false after creating your accounts
CORS_ORIGINS=http://localhost:5173

# SEO engine
CRAWL_MAX_PAGES_LIMIT=200
CRAWL_MAX_DEPTH_LIMIT=6
CRAWL_DELAY_SECONDS=0.5
MAX_CONCURRENT_AUDITS_PER_ORG=2
# SEO_CATEGORY_WEIGHTS={"technical":25,"onpage":25,"content":20,"indexability":15,"linking":10,"structured":5}

# AI providers. Keys stay on the server and are never sent to the browser. With none set, AI features are disabled.
AI_PROVIDER=none                   # none | gemini | openai | groq
AI_MODEL=                          # optional; empty = built-in default for the provider (model names change, so check)
AI_REQUESTS_PER_HOUR=40            # per organisation, to bound cost
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
